# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Solo se usa en Route Handlers/Server Actions que necesiten bypassear RLS
# (ej. tareas administrativas). NUNCA exponer con prefijo NEXT_PUBLIC_.
# Supabase → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# URL pública del sitio (usada para metadata OpenGraph y links de compartir)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth (Supabase → Authentication → Providers → Google)
# Client ID/Secret se configuran en Supabase, no acá. Dejar comentado
# como referencia de qué se necesita:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Apple OAuth (Supabase → Authentication → Providers → Apple)
# Se configura Services ID, Team ID, Key ID y la Private Key en Supabase.
